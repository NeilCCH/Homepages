rules_version = '2';

// Firestore 安全規則 — 個人網站
//
// posts（部落格）：所有人可讀；新增/刪除/編輯限管理者；按讚(likes)/分享(shares)
//                  開放訪客但只能對該欄位 +1。
// media（媒體相關）：所有人可讀；新增/編輯/刪除限管理者。
// promos（優惠連結）：所有人可讀；新增/編輯/刪除限管理者。
//
// 部署：Firebase 主控台 → Firestore Database → 規則 → 貼上並發布。

service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read: if true;

      allow create, delete: if request.auth != null
        && request.auth.token.email == 'neo0935@gmail.com';

      allow update: if
        (request.auth != null && request.auth.token.email == 'neo0935@gmail.com')
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes == resource.data.get('likes', 0) + 1
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares'])
          && request.resource.data.shares == resource.data.get('shares', 0) + 1
        );
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'neo0935@gmail.com';
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'neo0935@gmail.com';
    }

    // 其餘所有集合預設全部禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
